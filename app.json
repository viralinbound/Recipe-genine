{
  "expo": {
    "name": "Recipe Genie",
    "slug": "recipe-genie",
    "scheme": "recipegenie",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/chef-icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/chef-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF7EB"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.recipegenie.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Recipe Genie adds a calendar event when you schedule a meal, spanning cooking start to eating time.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "recipegenie"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/chef-icon.png",
        "backgroundColor": "#FFF7EB"
      },
      "package": "dev.recipegenie.app",
      "versionCode": 3,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "recipegenie",
              "host": "auth",
              "pathPrefix": "/"
            },
            {
              "scheme": "recipegenie"
            }
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/chef-icon.png",
          "backgroundColor": "#FFF7EB",
          "resizeMode": "contain"
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Recipe Genie uses your photos to set a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/chef-icon.png",
          "color": "#E85D3F"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Recipe Genie adds a calendar event when you schedule a meal, spanning cooking start to eating time."
        }
      ],
      "expo-web-browser",
      "./plugins/withSceneLifecycle"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "92792374-cc25-4e9f-92f1-f92cd48e1358"
      }
    },
    "owner": "gunanit"
  }
}
